{
  "name": "daily-ts",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Daily 10-minute TypeScript challenges that adapt to your level. Runs locally.",
  "scripts": {
    "dev": "concurrently -k -n api,web -c magenta,cyan \"tsx watch server/index.ts\" \"vite\"",
    "build": "vite build",
    "start": "vite build && NODE_ENV=production tsx server/index.ts",
    "serve": "NODE_ENV=production tsx server/index.ts",
    "validate": "tsx scripts/validate-challenges.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@hono/node-server": "^2.1.3",
    "@monaco-editor/react": "^4.7.0",
    "hono": "^4.13.11",
    "marked": "^18.0.14",
    "monaco-editor": "^0.57.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.1"
  }
}
