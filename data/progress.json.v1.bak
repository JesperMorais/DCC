      "code": "function hasItem(list: string[], item: string): boolean {\n  for (const t in list){\n    if (list[t] === item){\n      return true;\n    }\n  }\n  return false;\n}\n\nfunction positionOf(list: string[], item: string): number {\n  for (const t in list){\n    if(list[t] === item){\n      return Number(t);\n    }\n  }\n  return -1;\n}\n\nfunction addIfMissing(list: string[], item: string): string[] {\n  let found = false;\n  let size = 0;\n  let new_list: Array<string>;\n  new_list = [...list];\n  for(const t in list){\n    if(list[t] === item){\n      found = true;\n      break;\n    }\n    size+=1;\n  }\n  if (!found){\n    new_list[size++] = item;\n  }\n  return new_list;\n}\n",
