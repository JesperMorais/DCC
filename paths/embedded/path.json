    {
      "id": "fundamentals",
      "title": "Fundamentals",
      "color": "#3987e5",
      "blurb": "What every firmware engineer knows cold: registers, interrupts, scheduling, synchronisation."
    },
    {
      "id": "freertos",
      "title": "FreeRTOS",
      "color": "#2fa36b",
      "blurb": "The world's most deployed RTOS. Small, explicit, everywhere: from toothbrushes to satellites."
    },
    {
      "id": "zephyr",
      "title": "Zephyr",
      "color": "#8a5cf6",
      "blurb": "The Linux Foundation's RTOS: devicetree, Kconfig, west and a rich kernel. The modern way to build product firmware."
